# ==============================================================================
# MinerU 4.x - Configuración de entorno para start.bat / start.sh y Docker Compose
# Copiá este archivo como `.env` (los scripts lo crean automáticamente si falta).
# ==============================================================================

# Archivo Compose por defecto usado por start.bat / stop.bat / start.sh / stop.sh:
#   - compose.watcher-rtx4060-8gb.yaml   (WebUI + Watcher + API para GPU 8 GB; recomendado)
#   - compose.watcher-rtx3090-24gb.yaml  (WebUI + Watcher + API para GPU 24 GB)
#   - compose.rtx4060-8gb.yaml           (Solo WebUI para GPU 8 GB)
#   - compose.rtx3090-24gb.yaml          (Solo WebUI para GPU 24 GB)
MINERU_COMPOSE_FILE=compose.watcher-rtx4060-8gb.yaml

# Carpetas del modo Watcher (usá siempre barras "/" incluso en Windows):
#   Ejemplo Windows: C:/Users/TuUsuario/Downloads/input
#   Ejemplo Linux:   /home/tu-usuario/libros/entrada
MINERU_INPUT_DIR=./libros/entrada
MINERU_OUTPUT_DIR=./libros/salida
MINERU_PROCESSED_DIR=./libros/procesados
MINERU_FAILED_DIR=./libros/fallidos

# Puertos expuestos en el host
MINERU_WEBUI_PORT=7860
MINERU_API_PORT=8000

# GPU NVIDIA y presupuesto VRAM para vLLM
#   Descomentá estas dos líneas solo si querés sobrescribir el valor por defecto del Compose:
#   - compose.watcher-rtx4060-8gb.yaml  -> 0.65 / standard
#   - compose.watcher-rtx3090-24gb.yaml -> 0.70 / advanced
MINERU_GPU_ID=0
# MINERU_VLM_GPU_MEMORY_UTILIZATION=0.65

# Niveles y opciones del Watcher
#   - Tiers: flash, basic, standard (en RTX 3090 podés usar advanced)
#   - OCR mode: ocr (fuerza OCR en escaneados), auto (lee capa de texto si existe), txt
# MINERU_API_TIER=standard
WATCH_TIER=standard
WATCH_OCR_MODE=ocr
WATCH_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.tif,.tiff
WATCH_POLL_INTERVAL=5
WATCH_STABLE_SECONDS=3
WATCH_TIMEOUT_SECONDS=3600

# Zona horaria del contenedor
TZ=America/Argentina/Buenos_Aires
